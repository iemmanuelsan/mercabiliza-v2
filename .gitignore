# --- Segredos e credenciais (NUNCA versionar) ---
.streamlit/secrets.toml
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
service_account*.json
*serviceaccount*.json
.netrc
.pgpass
# Chaves SSH que às vezes aparecem em pasta de projeto por descuido
id_rsa
id_ed25519
id_*.pub

# Exceções: arquivos-MODELO, sem valor nenhum dentro, versionados de propósito
# para documentar QUAIS variáveis existem. A negação precisa vir depois da
# regra que ignora, senão o Git não a considera.
!.env.example
!.streamlit/secrets.toml.example

# --- Dados de clientes / LGPD ---

# Modelo dos segredos para rodar LOCALMENTE. Copie e preencha:
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# O arquivo secrets.toml está no .gitignore e NUNCA deve ser commitado.
# Este .example é versionado de propósito: documenta o formato sem valores.
#
# Em produção:
#   * Streamlit Community Cloud → cole o conteúdo abaixo no painel "Secrets".
#   * Render / Railway / Fly    → NÃO use este arquivo. Use as variáveis de
#     ambiente MERCABILIZA_SENHAS / MERCABILIZA_SENHA_GERAL (ver .env.example).
#     Não existe variável "STREAMLIT_SECRETS": o prefixo STREAMLIT_ configura
#     opções do Streamlit, não popula st.secrets.

# --------------------------------------------------------------------------- #
# Autenticação — uma senha por pessoa (recomendado)                           #
# --------------------------------------------------------------------------- #
# Uma entrada por pessoa permite saber quem entrou e revogar acesso individual
# sem trocar a senha de todo mundo.
#
# Gere cada senha com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

[senhas]
luisfelipe = "TROCAR-por-senha-gerada"
iago = "TROCAR-por-outra-senha-gerada"

# Alternativa mais simples, senha única para a equipe (não identifica quem é):
# senha_geral = "TROCAR-por-senha-gerada"


# --------------------------------------------------------------------------- #
# Autenticação de verdade (opcional) — login com a conta Google da empresa     #
# --------------------------------------------------------------------------- #
# Substitui a senha compartilhada: cada pessoa entra com a própria conta, herda
# o MFA do provedor e perde o acesso automaticamente ao ser desligada.
# Requer criar as credenciais OAuth no Google Cloud Console.
#
# [auth]
# redirect_uri = "https://SEU-APP.onrender.com/oauth2callback"
# cookie_secret = "gere com: python -c \"import secrets; print(secrets.token_hex(32))\""
#
# [auth.google]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
